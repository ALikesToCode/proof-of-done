{
  "name": "proof-of-done",
  "version": "0.1.0",
  "private": true,
  "description": "Makes Done mean proven for work handed to AI agents: a done contract, evidence with checks, a verdict on each piece, and a gate. Ships as a Forge app for Jira.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALikesToCode/proof-of-done.git"
  },
  "scripts": {
    "example": "tsx examples/agent-says-done.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:forge": "forge lint",
    "check": "npm run typecheck && npm run test && npm run lint:forge"
  },
  "dependencies": {
    "@forge/api": "8.5.1",
    "@forge/bridge": "7.4.0",
    "@forge/events": "3.0.11",
    "@forge/react": "12.6.0",
    "@forge/resolver": "2.0.2",
    "@forge/sql": "4.0.11",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-test-renderer": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "prosemirror-view": "1.43.1"
  }
}
