{
  "name": "proof-of-done",
  "version": "0.1.0",
  "private": true,
  "description": "A guard for work handed to AI agents: people set a done contract, the agent has to submit evidence that passes checks, someone else gives the verdict, and a gate holds until every criterion is proven. Ships as a Forge app for Jira.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALikesToCode/proof-of-done.git"
  },
  "bin": {
    "proof-of-done": "dist/local/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "example": "tsx examples/agent-says-done.ts",
    "pod": "tsx src/local/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:forge": "forge lint",
    "check": "npm run typecheck && npm run test && npm run lint:forge"
  },
  "dependencies": {
    "@forge/api": "8.5.1",
    "@forge/bridge": "7.4.0",
    "@forge/events": "3.0.11",
    "@forge/react": "12.6.0",
    "@forge/resolver": "2.0.2",
    "@forge/sql": "4.0.11",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-test-renderer": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "prosemirror-view": "1.43.1"
  }
}
